# CloudLeaf AI Environment Variables
# ====================================

# Direct Anthropic API Key (default reasoning provider)
# Obtain your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AWS Bedrock Configuration (optional, set BEDROCK_ENABLED=true to route via AWS Bedrock)
BEDROCK_ENABLED=false
AWS_REGION=us-east-1
